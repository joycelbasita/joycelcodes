
import React, { useEffect, useState } from 'react';
import {
  View,
  Text,
  ScrollView,
  StyleSheet,
  ActivityIndicator,
} from 'react-native';

export default function App() {
  // Store the data fetched from the API
  const [posts, setPosts] = useState([]);

  // Track the loading status
  const [loading, setLoading] = useState(true);

  // Store error messages
  const [error, setError] = useState(null);

  // Fetch data automatically when the component mounts
  useEffect(() => {
    const fetchPosts = async () => {
      try {
        // Make a GET request to the public API
        const response = await fetch(
          'https://jsonplaceholder.typicode.com/posts?_limit=10'
        );

        // Check if the request was successful
        if (!response.ok) {
          throw new Error('Failed to fetch posts.');
        }

        // Convert the response into JSON
        const data = await response.json();

        // Save the fetched data
        setPosts(data);

      } catch (err) {
        // Catch and display any errors
        setError(err.message);

      } finally {
        // Stop loading after the request finishes
        setLoading(false);
      }
    };

    fetchPosts();
  }, []);

  // Show loading message while fetching data
  if (loading) {
    return (
      <View style={styles.center}>
        <ActivityIndicator size="large" color="#2563EB" />
        <Text style={styles.message}>Loading posts...</Text>
      </View>
    );
  }

  // Show error if the request fails
  if (error) {
    return (
      <View style={styles.center}>
        <Text style={styles.error}>Error: {error}</Text>
      </View>
    );
  }

  // Display the fetched posts
  return (
    <ScrollView style={styles.container}>
      <Text style={styles.title}>Posts from API</Text>

      <Text style={styles.subtitle}>
        Data fetched from JSONPlaceholder
      </Text>

      {posts.map((post) => (
        <View key={post.id} style={styles.card}>
          <Text style={styles.postId}>
            Post #{post.id}
          </Text>

          <Text style={styles.postTitle}>
            {post.title}
          </Text>

          <Text style={styles.postBody}>
            {post.body}
          </Text>
        </View>
      ))}
    </ScrollView>
  );
}

